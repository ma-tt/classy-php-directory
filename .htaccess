# hidden_files in _classy/config.php only hides things from the listing,
# it doesn't stop a direct request for the URL. These rules cover that.

# Block dotfiles (.env, .git, .htpasswd, etc.) that might already be
# sitting in the folder this got dropped into.
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>

# No raw directory listing if index.php ever goes missing. Only follow
# symlinks owned by the same user as their target, so a symlink to
# /etc/passwd or similar won't get served.
Options -Indexes -FollowSymLinks +SymLinksIfOwnerMatch

# A few headers so a stray .svg/.html someone dropped in the folder can't
# do much if it's opened directly, and this page can't get framed by
# another site. Deliberately not touching script-src/style-src here since
# people drop their own analytics.inc or header.php/footer.php in and
# those need to keep working with zero config.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "object-src 'none'; frame-ancestors 'self'"
</IfModule>
